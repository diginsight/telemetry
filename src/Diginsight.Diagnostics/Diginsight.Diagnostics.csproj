<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <Title>Diginsight Diagnostics</Title>
    <PackageIcon>Diginsight.Diagnostics.png</PackageIcon>
    <PackageTags>$(PackageTags);diagnostics</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pastel" Version="7.*" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
      <PrivateAssets>contentfiles; analyzers; build; compile</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <Choose>
    <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net9.0'))">

      <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Diagnostics" Version="10.*" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.*" />
      </ItemGroup>

    </When>
    <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">

      <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Diagnostics" Version="9.*" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.*" />
      </ItemGroup>

    </When>
    <Otherwise>

      <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Diagnostics" Version="8.*" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.*" />
      </ItemGroup>

    </Otherwise>
  </Choose>

  <ItemGroup>
    <ProjectReference Include="..\Diginsight.Stringify\Diginsight.Stringify.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ActivitySourceExtensions.Public.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>ActivitySourceExtensions.Public.g.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="ActivitySourceExtensions.Public.g.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ActivitySourceExtensions.Public.tt</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
